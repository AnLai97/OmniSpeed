<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Labels and footers are keys into <lang>.lproj/Localizable.strings; "symbol"/"symbolColor" draw the row icon.
     Keys and defaults are the contract in App/OmniSpeed.h - the app reads them from the same domain. -->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>OmniSpeed</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>GENERAL_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>ENABLE</string>
			<key>symbol</key>
			<string>power</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>

		<!-- Display -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>DISPLAY_TITLE</string>
			<key>footerText</key>
			<string>DISPLAY_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SHOW_LIMIT</string>
			<key>symbol</key>
			<string>circle.circle.fill</string>
			<key>symbolColor</key>
			<string>#E84026</string>
			<key>key</key>
			<string>showLimit</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>SHOW_ROAD</string>
			<key>symbol</key>
			<string>signpost.right.fill</string>
			<key>symbolColor</key>
			<string>#36B37E</string>
			<key>key</key>
			<string>showRoad</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>KEEP_AWAKE</string>
			<key>symbol</key>
			<string>sun.max.fill</string>
			<key>symbolColor</key>
			<string>#FF9500</string>
			<key>key</key>
			<string>keepAwake</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>

		<!-- Over-limit warning -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>WARN_TITLE</string>
			<key>footerText</key>
			<string>WARN_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>WARN</string>
			<key>symbol</key>
			<string>exclamationmark.triangle.fill</string>
			<key>symbolColor</key>
			<string>#E8457C</string>
			<key>key</key>
			<string>warnEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>WARN_OVER_TITLE</string>
			<key>footerText</key>
			<string>WARN_OVER_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>warnOver</string>
			<key>default</key>
			<integer>5</integer>
			<key>min</key>
			<integer>-10</integer>
			<key>max</key>
			<integer>10</integer>
			<key>isSegmented</key>
			<true/>
			<key>segmentCount</key>
			<integer>20</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>

		<!-- Map data (OpenStreetMap through the Overpass API) -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>MAP_TITLE</string>
			<key>footerText</key>
			<string>MAP_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>CLASS_DEFAULTS</string>
			<key>symbol</key>
			<string>road.lanes</string>
			<key>symbolColor</key>
			<string>#8A93A6</string>
			<key>key</key>
			<string>classDefaults</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>SERVER</string>
			<key>symbol</key>
			<string>globe</string>
			<key>symbolColor</key>
			<string>#1E9BF0</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>server</string>
			<key>default</key>
			<integer>0</integer>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
				<integer>3</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>SERVER_0</string>
				<string>SERVER_1</string>
				<string>SERVER_2</string>
				<string>SERVER_3</string>
			</array>
			<key>defaults</key>
			<string>com.anlai.omnispeed</string>
			<key>PostNotification</key>
			<string>com.anlai.omnispeed/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>CLEAR_CACHE</string>
			<key>symbol</key>
			<string>trash.fill</string>
			<key>symbolColor</key>
			<string>#E84026</string>
			<key>isDestructive</key>
			<true/>
			<key>action</key>
			<string>clearCache</string>
		</dict>

		<!-- App -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APP_TITLE</string>
			<key>footerText</key>
			<string>APP_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>OPEN_APP</string>
			<key>symbol</key>
			<string>speedometer</string>
			<key>symbolColor</key>
			<string>#00A6B2</string>
			<key>action</key>
			<string>openApp</string>
		</dict>
	</array>
</dict>
</plist>
